if(TOUCH_BUILD_UI)
 include(FetchContent)
 FetchContent_Declare(imgui URL https://github.com/ocornut/imgui/archive/refs/tags/v1.91.9b.tar.gz)
 if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/vendor/imgui/imgui.h")
  set(FETCHCONTENT_SOURCE_DIR_IMGUI "${CMAKE_CURRENT_SOURCE_DIR}/vendor/imgui")
 endif()
 FetchContent_MakeAvailable(imgui)
 find_package(OpenGL REQUIRED)
 add_library(imgui STATIC ${imgui_SOURCE_DIR}/imgui.cpp ${imgui_SOURCE_DIR}/imgui_draw.cpp ${imgui_SOURCE_DIR}/imgui_tables.cpp ${imgui_SOURCE_DIR}/imgui_widgets.cpp ${imgui_SOURCE_DIR}/backends/imgui_impl_sdl3.cpp ${imgui_SOURCE_DIR}/backends/imgui_impl_opengl3.cpp)
 target_include_directories(imgui PUBLIC ${imgui_SOURCE_DIR} ${imgui_SOURCE_DIR}/backends)
 target_link_libraries(imgui PUBLIC PkgConfig::SDL OpenGL::GL)
 add_library(touch_ui src/ui/theme.cpp src/ui/canvas_geometry.cpp src/ui/editor.cpp src/ui/layout.cpp src/ui/settings.cpp src/ui/palette.cpp src/ui/files.cpp src/ui/inspector.cpp src/ui/preview.cpp src/ui/canvas.cpp src/ui/shortcuts.cpp src/ui/geometry.cpp src/ui/canvas_drawing.cpp src/ui/canvas_input.cpp src/ui/gestures.cpp src/ui/wires.cpp)
 target_link_libraries(touch_ui PUBLIC touch_core imgui)
 add_executable(touch src/app/main.cpp)
 target_link_libraries(touch PRIVATE touch_ui)
 add_dependencies(touch example_nodes)
 add_custom_command(TARGET touch POST_BUILD
  COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:touch>/plugins"
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "$<TARGET_FILE:example_nodes>" "$<TARGET_FILE_DIR:touch>/plugins/")
 if(APPLE)
  set_target_properties(touch PROPERTIES MACOSX_BUNDLE TRUE MACOSX_BUNDLE_INFO_PLIST "${CMAKE_CURRENT_SOURCE_DIR}/Info.plist")
 endif()
endif()
